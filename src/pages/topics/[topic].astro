---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHead from '../../components/PageHead.astro';
import EntryList from '../../components/EntryList.astro';
import { getTopics, type TopicGroup } from '../../lib/content';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((group) => ({ params: { topic: group.id }, props: { group } }));
}

interface Props {
  group: TopicGroup;
}

const { group } = Astro.props;
const { id, labels, description, entries } = group;
const count = entries.length;
const entryLabel = count === 1 ? 'entry' : 'entries';
const title = labels.en || id;
---
<MainLayout title={`Topic / ${title}`} description={description}>
  <PageHead
    kicker={`Topic / ${count} ${entryLabel}`}
    title={title}
    deck={description}
    asideLines={[`${count} ${entryLabel}`, 'Broad shelf', 'Topic']}
    glyph="library"
  />
  <div class="wrap section-body">
    <EntryList entries={entries} />
    <p class="section-note">Canonical id / {id}</p>
    <p class="section-note">
      <a class="recent-link" href={`/search/?topic=${encodeURIComponent(id)}`}>
        Filter the archive by this topic
      </a>
    </p>
    <p class="section-note"><a class="recent-link" href="/topics/">All topics</a></p>
  </div>
</MainLayout>
