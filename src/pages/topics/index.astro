---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHead from '../../components/PageHead.astro';
import { getTopics, textLang } from '../../lib/content';

const topics = await getTopics();
---
<MainLayout
  title="Topics"
  description="The broad browsing layer of the archive, with multilingual labels and aliases."
>
  <PageHead
    kicker="Topics / The broad shelves"
    title="Topics"
    deck="Broad domains that gather entries across languages, tags, and sections."
    asideLines={[`${topics.length} topics`, 'Broad shelves', 'Aliases in search']}
    glyph="library"
  />
  <div class="wrap section-body">
    <div class="topic-index-grid">
      {
        topics.map((topic) => {
          const sections = [...new Set(topic.entries.map((entry) => entry.category))];
          return (
            <a class="topic-index-card" href={`/topics/${encodeURIComponent(topic.id)}/`}>
              <span class="topic-index-kicker">
                {topic.labels.en} · {topic.labels.ja}
              </span>
              <span class="topic-index-title" lang={textLang(topic.labels.zh)}>
                {topic.labels.zh}
              </span>
              <span class="topic-index-desc">{topic.description}</span>
              <span class="topic-index-meta">
                {topic.entries.length} {topic.entries.length === 1 ? 'entry' : 'entries'} ·{' '}
                {sections.join(' · ')}
              </span>
              <span class="topic-index-enter">Browse the topic →</span>
            </a>
          );
        })
      }
    </div>
    <p class="section-note">
      <a class="recent-link" href="/tags/">Browse the precise tags</a>
    </p>
    <p class="section-note"><a class="recent-link" href="/search/">Filter the full archive</a></p>
  </div>
</MainLayout>
