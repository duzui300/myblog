---
import MainLayout from '../layouts/MainLayout.astro';
import PageHead from '../components/PageHead.astro';
import {
  formatDate,
  getCategoryCounts,
  getLanguages,
  getPopularTags,
  getSearchEntries,
  getSeriesGroups,
  isLanguageTag,
  langCode,
  textLang,
  type SearchEntry,
} from '../lib/content';
import { sections, navGroups } from '../data/sections';

const entries = await getSearchEntries();
const popularTags = await getPopularTags(8);
const counts = await getCategoryCounts();
const languages = await getLanguages();
const series = await getSeriesGroups();
const topics = [...new Set(entries.flatMap((entry) => entry.topics))].sort((a, b) =>
  a.localeCompare(b),
);
const tags = [
  ...new Set(entries.flatMap((entry) => entry.tags).filter((tag) => tag && !isLanguageTag(tag))),
].sort((a, b) => a.localeCompare(b));
const years = [...new Set(entries.map((entry) => String(new Date(entry.date).getFullYear())))].sort(
  (a, b) => Number(b) - Number(a),
);
const browseGroups = navGroups.map((group) => ({
  ...group,
  items: group.keys.map((key) => {
    const section = sections.find((item) => item.key === key)!;
    return { key, title: section.title, href: section.href, count: counts[key] };
  }),
}));

const monthNames = [
  'January',
  'February',
  'March',
  'April',
  'May',
  'June',
  'July',
  'August',
  'September',
  'October',
  'November',
  'December',
];

type MonthGroup = { key: string; label: string; count: number; entries: SearchEntry[] };
type YearGroup = { year: string; count: number; months: MonthGroup[] };

const yearMap = new Map<string, Map<string, SearchEntry[]>>();
for (const entry of entries) {
  const date = new Date(entry.date);
  const year = String(date.getFullYear());
  const month = String(date.getMonth());
  if (!yearMap.has(year)) yearMap.set(year, new Map());
  const months = yearMap.get(year)!;
  if (!months.has(month)) months.set(month, []);
  months.get(month)!.push(entry);
}

const archive: YearGroup[] = [...yearMap.entries()]
  .sort((a, b) => Number(b[0]) - Number(a[0]))
  .map(([year, months]) => {
    const monthGroups = [...months.entries()]
      .sort((a, b) => Number(b[0]) - Number(a[0]))
      .map(([month, list]) => ({
        key: `${year}-${month}`,
        label: monthNames[Number(month)],
        count: list.length,
        entries: [...list].sort((a, b) => b.date.localeCompare(a.date)),
      }));
    return {
      year,
      count: monthGroups.reduce((sum, month) => sum + month.count, 0),
      months: monthGroups,
    };
  });
---
<MainLayout
  title="Archive"
  description="Search the complete archive, or combine section, language, topic, tag, year, and series filters."
>
  <PageHead
    kicker="Archive / Search and filter"
    title="Explore the Archive"
    deck="Search the full text, or combine section, language, topic, tag, year, and series filters."
    asideLines={[`${entries.length} entries`, `${languages.length} languages`, 'Unified index']}
    glyph="library"
  />

  <section class="search-page">
    <div class="wrap search-layout">
      <div class="search-main">
        <form class="search-form" role="search" onsubmit="return false">
          <label class="sr-only" for="archive-search">Search the archive</label>
          <input
            id="archive-search"
            type="search"
            placeholder="Search notes, thoughts, research, projects..."
            autocomplete="off"
            aria-controls="search-results"
          />
          <p class="search-status" data-search-status role="status" aria-live="polite">
            {entries.length} entries indexed. Type to search or choose a filter.
          </p>
        </form>

        <form
          class="filter-bar archive-filters"
          data-archive-filters
          aria-label="Filter the archive"
          hidden
        >
          <span class="filter-label">Filter</span>
          <label class="filter-field">
            <span>Section</span>
            <select data-filter="section">
              <option value="">All</option>
              {sections.map((section) => (
                <option value={section.key}>
                  {section.title} ({counts[section.key]})
                </option>
              ))}
            </select>
          </label>
          <label class="filter-field">
            <span>Language</span>
            <select data-filter="lang">
              <option value="">All</option>
              {languages.map(({ lang, entries: languageEntries }) => (
                <option value={lang}>{lang} ({languageEntries.length})</option>
              ))}
            </select>
          </label>
          {topics.length > 0 && (
            <label class="filter-field">
              <span>Topic</span>
              <select data-filter="topic">
                <option value="">All</option>
                {topics.map((topic) => (
                  <option value={topic}>{topic}</option>
                ))}
              </select>
            </label>
          )}
          <label class="filter-field">
            <span>Tag</span>
            <select data-filter="tag">
              <option value="">All</option>
              {tags.map((tag) => (
                <option value={tag}>{tag}</option>
              ))}
            </select>
          </label>
          {years.length > 1 && (
            <label class="filter-field">
              <span>Year</span>
              <select data-filter="year">
                <option value="">All</option>
                {years.map((year) => (
                  <option value={year}>{year}</option>
                ))}
              </select>
            </label>
          )}
          {series.length > 0 && (
            <label class="filter-field">
              <span>Series</span>
              <select data-filter="series">
                <option value="">All</option>
                {series.map((group) => (
                  <option value={group.slug}>{group.title}</option>
                ))}
              </select>
            </label>
          )}
          <button class="filter-reset" type="reset">Reset</button>
          <span class="filter-status" data-filter-status role="status" aria-live="polite">
            All {entries.length} entries
          </span>
        </form>

        <div class="search-results" id="search-results" data-search-results></div>
        <noscript>
          <p class="section-note">
            Search needs JavaScript. The chronological archive below lists every entry.
          </p>
        </noscript>
      </div>
      <aside class="search-side" aria-label="Browse the archive">
        <section class="search-block">
          <p class="smallcaps">Browse by category</p>
          <div class="category-groups">
            {
              browseGroups.map((group) => (
                <div class="category-group">
                  <p class="category-group-label">
                    {group.no} {group.title}
                  </p>
                  <ul class="category-list">
                    {group.items.map((item) => (
                      <li>
                        <a href={item.href}>
                          <span>{item.title}</span>
                          <span class="count">{String(item.count).padStart(2, '0')}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>
        <section class="search-block">
          <p class="smallcaps">Browse by language</p>
          <div class="tag-cloud">
            {
              languages.map(({ lang, entries: languageEntries }) => (
                <a href={`/languages/${encodeURIComponent(lang)}/`} lang={langCode(lang)}>
                  {lang}
                  <span>{languageEntries.length}</span>
                </a>
              ))
            }
          </div>
        </section>
        <section class="search-block">
          <p class="smallcaps">Collections</p>
          <div class="tag-cloud">
            <a href="/selected/">Selected</a>
            <a href="/series/">Series{series.length > 0 ? <span>{series.length}</span> : null}</a>
            <a href="/languages/">Languages</a>
          </div>
        </section>
        <section class="search-block">
          <p class="smallcaps">Popular tags</p>
          <div class="tag-cloud">
            {
              popularTags.map(({ tag, entries: tagged }) => (
                <a href={`/tags/${encodeURIComponent(tag)}/`} lang={textLang(tag)}>
                  {tag}
                  <span>{tagged.length}</span>
                </a>
              ))
            }
          </div>
        </section>
      </aside>
    </div>

    <div class="wrap archive-block">
      <div class="archive-head">
        <p class="smallcaps">Chronological archive</p>
        <h2>Every entry, by month</h2>
      </div>
      <div class="archive">
        {
          archive.map((year) => (
            <section class="archive-year">
              <div class="archive-year-head">
                <h3>{year.year}</h3>
                <span>
                  {year.count} {year.count === 1 ? 'entry' : 'entries'}
                </span>
              </div>
              <div class="archive-months">
                {year.months.map((month) => (
                  <details class="archive-month">
                    <summary>
                      <span>{month.label}</span>
                      <span class="count">{month.count}</span>
                    </summary>
                    <ul>
                      {month.entries.map((entry) => (
                        <li>
                          <a href={entry.href}>
                            <span class="archive-cat">{entry.category}</span>
                            <span lang={langCode(entry.langs[0])}>{entry.title}</span>
                            <time datetime={entry.date}>{formatDate(new Date(entry.date))}</time>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { normalizeSearchText } from '../lib/search-normalize';

  type SearchItem = {
    section: string;
    category: string;
    group: string;
    kind: string;
    title: string;
    href: string;
    date: string;
    langs: string[];
    topics: string[];
    tags: string[];
    description: string;
    series?: string;
    seriesOrder?: number;
    seriesTitle?: string;
    body: string;
  };

  const input = document.querySelector<HTMLInputElement>('#archive-search');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const filterForm = document.querySelector<HTMLFormElement>('[data-archive-filters]');
  const filterStatus = document.querySelector<HTMLElement>('[data-filter-status]');
  const base = import.meta.env.BASE_URL;
  let entries: SearchItem[] = [];

  const normalize = (value: string) => normalizeSearchText(value);

  function languageOf(langs: string[] | undefined): string {
    const lang = langs?.[0];
    if (lang === '日本語') return 'ja';
    if (lang === '中文') return 'zh-Hans';
    return 'en';
  }

  function activeFilters(): Record<string, string> {
    if (!filterForm) return {};
    const active: Record<string, string> = {};
    for (const select of filterForm.querySelectorAll<HTMLSelectElement>('select[data-filter]')) {
      if (select.value) active[select.dataset.filter ?? ''] = select.value;
    }
    return active;
  }

  function matchesFilters(entry: SearchItem, active: Record<string, string>): boolean {
    if (active.section && entry.section !== active.section) return false;
    if (active.lang && !entry.langs.includes(active.lang)) return false;
    if (active.topic && !entry.topics.includes(active.topic)) return false;
    if (active.tag && !entry.tags.includes(active.tag)) return false;
    if (active.year && entry.date.slice(0, 4) !== active.year) return false;
    if (active.series && entry.series !== active.series) return false;
    return true;
  }

  function updateUrl() {
    const url = new URL(location.href);
    if (input?.value.trim()) url.searchParams.set('q', input.value.trim());
    else url.searchParams.delete('q');

    if (filterForm) {
      for (const select of filterForm.querySelectorAll<HTMLSelectElement>('select[data-filter]')) {
        const key = select.dataset.filter ?? '';
        if (select.value) url.searchParams.set(key, select.value);
        else url.searchParams.delete(key);
      }
    }
    history.replaceState(null, '', url);
  }

  function baseStatus() {
    return `${entries.length} entries indexed. Type to search or choose a filter.`;
  }

  function run() {
    if (!input || !results || !status) return;
    const query = normalize(input.value.trim());
    const filters = activeFilters();
    const filterKeys = Object.keys(filters);
    const terms = query.split(/\s+/).filter(Boolean);

    if (!terms.length && !filterKeys.length) {
      results.replaceChildren();
      status.textContent = baseStatus();
      if (filterStatus) filterStatus.textContent = `All ${entries.length} entries`;
      return;
    }

    const matched = entries.filter((entry) => {
      if (!matchesFilters(entry, filters)) return false;
      if (!terms.length) return true;
      const haystack = normalize(
        [
          entry.title,
          entry.description,
          entry.category,
          entry.group,
          entry.langs.join(' '),
          entry.topics.join(' '),
          entry.tags.join(' '),
          entry.seriesTitle ?? '',
          entry.body,
        ].join(' '),
      );
      return terms.every((term) => haystack.includes(term));
    });

    const context = [];
    if (terms.length) context.push(`for “${input.value.trim()}”`);
    if (filterKeys.length) context.push('with the selected filters');
    status.textContent =
      `${matched.length} ${matched.length === 1 ? 'result' : 'results'} ${context.join(' ')}` +
      (matched.length > 30 ? ' · showing first 30' : '');
    if (filterStatus) filterStatus.textContent = `${matched.length} of ${entries.length}`;

    results.replaceChildren();
    for (const entry of matched.slice(0, 30)) {
      const link = document.createElement('a');
      link.className = 'search-result';
      link.href = entry.href;

      const meta = document.createElement('span');
      meta.className = 'search-result-meta';
      meta.textContent = [entry.category, entry.seriesTitle].filter(Boolean).join(' · ');

      const date = document.createElement('span');
      date.className = 'search-result-date';
      date.textContent = entry.date.slice(0, 10).replaceAll('-', '.');

      const title = document.createElement('span');
      title.className = 'search-result-title';
      title.lang = languageOf(entry.langs);
      title.textContent = entry.title;

      const description = document.createElement('span');
      description.className = 'search-result-desc';
      description.lang = languageOf(entry.langs);
      description.textContent = entry.description;

      const tags = document.createElement('span');
      tags.className = 'search-result-tags';
      tags.textContent = [...entry.topics, ...entry.tags].slice(0, 4).join(' · ');

      link.append(meta, date, title, description, tags);
      results.append(link);
    }
    if (!matched.length) {
      const empty = document.createElement('p');
      empty.className = 'search-empty';
      empty.textContent =
        'No records match the query. Check the spelling or browse the chronological archive below.';
      results.append(empty);
    }
  }

  async function load() {
    if (!status) return;
    try {
      const response = await fetch(`${base}search.json`);
      entries = await response.json();
      status.textContent = baseStatus();
      if (filterForm) {
        filterForm.hidden = false;
        for (const select of filterForm.querySelectorAll<HTMLSelectElement>('select[data-filter]')) {
          const value = new URLSearchParams(location.search).get(select.dataset.filter ?? '');
          if (value) select.value = value;
        }
      }
      const query = new URLSearchParams(location.search).get('q');
      if (query && input) input.value = query;
      run();
    } catch {
      status.textContent = 'The search index could not be loaded. The archive below is complete.';
    }
  }

  input?.addEventListener('input', () => {
    run();
    updateUrl();
  });

  filterForm?.addEventListener('change', () => {
    run();
    updateUrl();
  });
  filterForm?.addEventListener('reset', () => {
    requestAnimationFrame(() => {
      run();
      updateUrl();
    });
  });
  filterForm?.addEventListener('submit', (event) => event.preventDefault());

  const searchMain = input?.closest<HTMLElement>('.search-main');
  searchMain?.addEventListener('keydown', (event) => {
    if (event.isComposing || !input || !results) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      input.value = '';
      filterForm
        ?.querySelectorAll<HTMLSelectElement>('select[data-filter]')
        .forEach((select) => (select.value = ''));
      run();
      updateUrl();
      input.focus();
      return;
    }
    if (event.key === 'Enter' && event.target === input) {
      const first = results.querySelector<HTMLElement>('.search-result');
      if (first) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  load();
</script>
