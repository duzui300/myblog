---
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import ChordFigure from '../../components/ChordFigure.astro';
import { getAdjacent, getThoughtEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getThoughtEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { prev, next } = await getAdjacent('thoughts', entry.id);
---
<ContentLayout
  entry={entry}
  sectionKey="thoughts"
  kind="Thought"
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
  {entry.data.figure === 'chord' && <ChordFigure slot="margin" />}
</ContentLayout>
