---
import { render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import EntryFigure from '../../components/EntryFigure.astro';
import { getAdjacent, getResearchEntries } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getResearchEntries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { prev, next } = await getAdjacent('research', entry.id);
---
<ContentLayout
  entry={entry}
  sectionKey="research"
  kind={entry.data.kind}
  headings={headings}
  prev={prev}
  next={next}
>
  <EntryFigure slot="hero" figure={entry.data.figure} />
  <Content />
</ContentLayout>
