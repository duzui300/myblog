---
import 'katex/dist/katex.min.css';
import MainLayout from './MainLayout.astro';
import ModeBand from '../components/ModeBand.astro';
import RunningFolio from '../components/RunningFolio.astro';
import Toc from '../components/Toc.astro';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { ContentKey, EntrySummary } from '../lib/content';
import { formatDate, langCode, textLang } from '../lib/content';
import { sections } from '../data/sections';

interface Action {
  label: string;
  href: string;
}

interface Props {
  entry:
    | CollectionEntry<'notes'>
    | CollectionEntry<'thoughts'>
    | CollectionEntry<'research'>
    | CollectionEntry<'projects'>;
  sectionKey: ContentKey;
  kind: string;
  headings: MarkdownHeading[];
  prev: EntrySummary | null;
  next: EntrySummary | null;
  meta?: { label: string; value: string }[];
  actions?: Action[];
}

const { entry, sectionKey, kind, headings, prev, next, meta, actions = [] } = Astro.props;
const section = sections.find((item) => item.key === sectionKey)!;
const bandMode =
  section.modeKey === 'observatory' || section.modeKey === 'frontier'
    ? section.modeKey
    : null;
const lang = langCode(entry.data.lang[0]);
const metaItems = meta ?? entry.data.meta;
const folio = `${section.title} · Vol. I / 2026`;
const tocLabel = `In this ${kind.toLowerCase()}`;
const hasMargin =
  metaItems.length > 0 || entry.data.margin.length > 0 || Astro.slots.has('margin');
const isExternal = (href: string) => href.startsWith('http://') || href.startsWith('https://');

const isThought = entry.collection === 'thoughts';
const hasTruncatedDeck =
  entry.data.description &&
  (entry.data.description.endsWith('...') || entry.data.description.endsWith('……'));
const showDeck = !isThought && !hasTruncatedDeck && Boolean(entry.data.description);
---
<MainLayout title={entry.data.title} description={entry.data.description}>
  {
    bandMode && (
      <ModeBand
        mode={bandMode}
        kicker={`${section.groupLabel} / ${section.title}`}
        title={entry.data.title}
        deck={showDeck ? entry.data.description : undefined}
        metaLines={[
          formatDate(entry.data.date),
          entry.data.lang.join(' · '),
          entry.data.reading ?? kind,
          section.mode,
        ]}
        titleId="entry-title"
        tags={entry.data.tags}
        lang={lang}
      >
        <slot name="hero" />
      </ModeBand>
    )
  }
  <RunningFolio folio={folio} lang={lang} tone={sectionKey} />
  <div class="wrap entry-wrap">
    <div class={`entry-layout${hasMargin ? '' : ' no-margin'}`}>
      <Toc headings={headings} label={tocLabel} folio={folio} lang={lang} />
      <article class={`entry-main tone-${sectionKey}`}>
        {
          !bandMode && (
            <header class="entry-header">
              <p class="entry-kicker">
                <span class="tone-swatch" aria-hidden="true" />
                <a href={section.href}>{section.groupLabel} / {section.title}</a>
              </p>
              <h1 class="entry-title" id="entry-title" lang={lang}>{entry.data.title}</h1>
              {showDeck && <p class="entry-deck" lang={lang}>{entry.data.description}</p>}
              <p class="entry-meta">
                {formatDate(entry.data.date)} /{' '}
                <span>
                  {entry.data.lang.map((language, index) => (
                    <span lang={langCode(language)}>
                      {index > 0 ? ' · ' : ''}
                      {language}
                    </span>
                  ))}
                </span>{' '}
                / {entry.data.reading ?? kind} / Vol. I
              </p>
              {
                entry.data.tags.length > 0 && (
                  <div class="entry-tags">
                    {entry.data.tags.map((tag) => (
                      <a
                        class="entry-tag"
                        href={`/tags/${encodeURIComponent(tag)}/`}
                        lang={textLang(tag)}
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )
              }
            </header>
          )
        }

        <div class={`prose${entry.data.dropcap ? ' dropcap' : ''}`} lang={lang}>
          <slot />
        </div>

        {
          actions.length > 0 && (
            <div class="entry-actions">
              {actions.map((action) => (
                <a
                  class="home-link"
                  href={action.href}
                  target={isExternal(action.href) ? '_blank' : undefined}
                  rel={isExternal(action.href) ? 'noreferrer' : undefined}
                >
                  {action.label}
                </a>
              ))}
            </div>
          )
        }

      </article>
      <aside class="entry-margin" aria-label="Marginalia">
        <p class="margin-heading">Marginalia</p>
        {
          metaItems.length > 0 && (
            <dl class="margin-meta">
              {metaItems.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          entry.data.margin.map((note) => (
            <p class="margin-note">
              <b>{note.label}</b>
              {note.text}
            </p>
          ))
        }
        <slot name="margin" />
      </aside>
      <nav class="entry-pager" aria-label="Entry navigation">
        {
          prev ? (
            <a class="pager-link" href={prev.href}>
              <span class="label">Previous</span>
              <span class="title">{prev.title}</span>
            </a>
          ) : (
            <a class="pager-link" href={section.href}>
              <span class="label">Back</span>
              <span class="title">All {section.title.toLowerCase()}</span>
            </a>
          )
        }
        {
          next && (
            <a class="pager-link next" href={next.href}>
              <span class="label">Next</span>
              <span class="title">{next.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </div>
</MainLayout>

<script>
  function markScrollableFormulas() {
    const formulas = document.querySelectorAll<HTMLElement>(
      '.prose .katex-display, .prose :where(p, li):has(> .katex:only-child)',
    );
    formulas.forEach((formula) => {
      if (formula.scrollWidth > formula.clientWidth + 1) {
        formula.tabIndex = 0;
        formula.setAttribute('role', 'group');
        formula.setAttribute('aria-label', 'Scrollable formula');
      } else {
        formula.removeAttribute('tabindex');
        formula.removeAttribute('role');
        formula.removeAttribute('aria-label');
      }
    });
  }

  markScrollableFormulas();
  document.fonts?.ready.then(markScrollableFormulas).catch(() => {});
  window.addEventListener('resize', markScrollableFormulas, { passive: true });
</script>
