---
import { langCode } from '../lib/content';

interface Props {
  languages: string[];
  allHref?: string;
}

const { languages, allHref = '/notes/' } = Astro.props;
---
<nav class="filter-bar" aria-label="Browse by language">
  <span class="filter-label">Browse by language</span>
  <a class="filter active" href={allHref} aria-current="page">All entries</a>
  {
    languages.map((lang) => (
      <a
        class="filter"
        href={`/tags/${encodeURIComponent(lang)}/`}
        lang={langCode(lang)}
        aria-label={`Browse entries tagged ${lang}`}
      >
        {lang} <span class="filter-arrow" aria-hidden="true">→</span>
      </a>
    ))
  }
</nav>
