---
const step = 36;
const isoDots: { x: number; y: number }[] = [];
for (let row = 0; row <= 20; row++) {
  for (let col = 0; col <= 16; col++) {
    const x = col * step + (row % 2) * (step / 2);
    const y = row * step * 0.866;
    if (x <= 600 && y <= 600) isoDots.push({ x, y });
  }
}

const top = { x: 300, y: 130 };
const topRight = { x: 447, y: 215 };
const topLeft = { x: 153, y: 215 };
const center = { x: 300, y: 300 };
const bottomRight = { x: 447, y: 385 };
const bottomLeft = { x: 153, y: 385 };
const bottom = { x: 300, y: 470 };

const edges = [
  { a: topLeft, b: top, delay: 0.12 },
  { a: top, b: topRight, delay: 0.18 },
  { a: topRight, b: bottomRight, delay: 0.24 },
  { a: bottomRight, b: bottom, delay: 0.3 },
  { a: bottom, b: bottomLeft, delay: 0.36 },
  { a: bottomLeft, b: topLeft, delay: 0.42 },
  { a: top, b: center, delay: 0.5 },
  { a: center, b: bottomRight, delay: 0.56 },
  { a: center, b: bottomLeft, delay: 0.62 },
  { a: topRight, b: center, delay: 0.7 },
  { a: center, b: topLeft, delay: 0.76 },
];

const ring = { cx: 300, cy: 300, rx: 232, ry: 82, innerRx: 208, innerRy: 70, angle: -18 };
const angle = (ring.angle * Math.PI) / 180;
const onRing = (rx: number, ry: number, t: number) => {
  const x = ring.cx + Math.cos(t) * rx;
  const y = ring.cy + Math.sin(t) * ry;
  return {
    x: ring.cx + (x - ring.cx) * Math.cos(angle) - (y - ring.cy) * Math.sin(angle),
    y: ring.cy + (x - ring.cx) * Math.sin(angle) + (y - ring.cy) * Math.cos(angle),
  };
};
const ringTicks = Array.from({ length: 24 }, (_, index) => {
  const t = (index * Math.PI) / 12;
  return {
    inner: onRing(ring.innerRx, ring.innerRy, t),
    outer: onRing(ring.rx, ring.ry, t),
    major: index % 6 === 0,
  };
});
const ringNodes = [30, 150, 270].map((degrees, index) => ({
  ...onRing(ring.rx, ring.ry, (degrees * Math.PI) / 180),
  delay: 1.45 + index * 0.12,
}));
---
<svg viewBox="0 0 600 600" role="img" aria-labelledby="frontier-fig-title">
  <title id="frontier-fig-title">A wireframe cube held inside a calibrated orbital ring</title>
  <g fill="rgba(243,239,229,.15)" class="fig-fade" style="--fig-delay:0s;animation-duration:1.2s">
    {isoDots.map((dot) => <circle cx={dot.x} cy={dot.y} r=".8" />)}
  </g>

  <g stroke="rgba(243,239,229,.10)" stroke-width=".8" class="fig-fade" style="--fig-delay:.1s">
    <line x1="50" y1="300" x2="550" y2="300" />
    <line x1="300" y1="50" x2="300" y2="550" />
  </g>

  <g fill="none" stroke="var(--brass)" stroke-width="1.25">
    {
      edges.map((edge) => (
        <line
          class="fig-draw"
          pathLength="1"
          x1={edge.a.x}
          y1={edge.a.y}
          x2={edge.b.x}
          y2={edge.b.y}
          style={`--fig-delay:${edge.delay}s`}
        />
      ))
    }
    <g opacity=".35">
      <line
        class="fig-fade"
        x1={center.x}
        y1={center.y}
        x2={bottom.x}
        y2={bottom.y}
        stroke-dasharray="3 6"
        style="--fig-delay:.9s"
      />
    </g>
  </g>

  <g fill="none" stroke="var(--brass)">
    <ellipse
      class="fig-draw"
      pathLength="1"
      cx={ring.cx}
      cy={ring.cy}
      rx={ring.rx}
      ry={ring.ry}
      transform={`rotate(${ring.angle} ${ring.cx} ${ring.cy})`}
      stroke-width="1.3"
      style="--fig-delay:1s;animation-duration:1.2s"
    />
    <ellipse
      class="fig-draw"
      pathLength="1"
      cx={ring.cx}
      cy={ring.cy}
      rx={ring.innerRx}
      ry={ring.innerRy}
      transform={`rotate(${ring.angle} ${ring.cx} ${ring.cy})`}
      stroke-width=".7"
      opacity=".5"
      style="--fig-delay:1.1s;animation-duration:1.2s"
    />
  </g>

  <g class="fig-fade" stroke="var(--brass)" stroke-width=".8" style="--fig-delay:1.35s">
    {
      ringTicks.map((tick) => (
        <line
          x1={tick.inner.x}
          y1={tick.inner.y}
          x2={tick.outer.x}
          y2={tick.outer.y}
          opacity={tick.major ? '.68' : '.38'}
        />
      ))
    }
  </g>

  <g fill="var(--brass)">
    {ringNodes.map((node) => <circle class="fig-pop" cx={node.x} cy={node.y} r="2.2" style={`--fig-delay:${node.delay}s`} />)}
  </g>
  <circle class="fig-pop" cx={center.x} cy={center.y} r="3.4" fill="var(--oxide)" style="--fig-delay:1.32s" />

  <g class="fig-fade" font-family="IBM Plex Mono, monospace" font-size="9" fill="rgba(243,239,229,.5)" letter-spacing=".08em" style="--fig-delay:1.55s">
    <text x="48" y="62">FIG. IV / A CUBE IN ORBIT</text>
    <text x="552" y="62" text-anchor="end">THE FRONTIER</text>
    <text x="48" y="556">EDGES FIRST</text>
    <text x="552" y="556" text-anchor="end">NOT A RENDER</text>
  </g>
</svg>
<figcaption class="mode-caption">A prototype is a box held inside an open question. The Frontier draws the edges before the answer arrives.</figcaption>
