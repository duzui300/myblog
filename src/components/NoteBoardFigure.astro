---
const gridX = Array.from({ length: 19 }, (_, index) => 42 + index * 26);
const gridY = Array.from({ length: 12 }, (_, index) => 42 + index * 26);

const pins = [
  { x: 190, y: 72, delay: 0.82 },
  { x: 70, y: 152, delay: 0.88 },
  { x: 322, y: 66, delay: 0.94 },
  { x: 454, y: 156, delay: 1.0 },
  { x: 338, y: 220, delay: 1.06 },
  { x: 194, y: 302, delay: 1.12 },
  { x: 80, y: 226, delay: 1.02 },
  { x: 142, y: 302, delay: 1.08 },
];

const threads = [
  { d: 'M 190 72 Q 256 36 322 66', delay: 0.46 },
  { d: 'M 454 156 Q 410 204 338 220', delay: 0.58 },
  { d: 'M 194 302 Q 168 316 142 302', delay: 0.7 },
  { d: 'M 80 226 Q 48 196 70 152', delay: 0.82 },
];
---
<figure class="library-figure">
  <div class="figure-band">
    <span><b>FIG. 01</b> / The pinboard</span><span>Notes / 01.1</span>
  </div>
  <svg viewBox="0 0 520 380" role="img" aria-labelledby="noteboard-title noteboard-desc">
    <title id="noteboard-title">Notes pinned across a working board</title>
    <desc id="noteboard-desc">
      Paper slips pinned to a gridded board and joined by threads: a source, a note, a turn, and an
      open question.
    </desc>

    <g class="fig-fade" stroke="var(--rule-strong)" fill="none" stroke-width="1" style="--fig-delay:0s">
      <rect x="18" y="18" width="484" height="344" />
      <line x1="18" y1="32" x2="32" y2="32" /><line x1="18" y1="32" x2="18" y2="46" />
      <line x1="502" y1="32" x2="488" y2="32" /><line x1="502" y1="32" x2="502" y2="46" />
      <line x1="18" y1="348" x2="32" y2="348" /><line x1="18" y1="348" x2="18" y2="334" />
      <line x1="502" y1="348" x2="488" y2="348" /><line x1="502" y1="348" x2="502" y2="334" />
    </g>

    <g class="fig-fade" stroke="var(--grid-ink)" stroke-width=".6" style="--fig-delay:.06s;animation-duration:1s">
      {gridX.map((x) => <line x1={x} y1="42" x2={x} y2="338" />)}
      {gridY.map((y) => <line x1="42" y1={y} x2="478" y2={y} />)}
    </g>

    <g fill="none" stroke="var(--oxide)" stroke-width="1" opacity=".55">
      {
        threads.map((thread) => (
          <path class="fig-draw" pathLength="1" d={thread.d} style={`--fig-delay:${thread.delay}s`} />
        ))
      }
    </g>

    <g class="fig-rise" style="--fig-delay:.1s">
      <g transform="rotate(-4 130 112)">
        <rect x="68" y="72" width="132" height="92" fill="var(--figure-shadow)" />
        <rect x="64" y="66" width="132" height="92" fill="var(--paper)" stroke="var(--rule-strong)" />
        <text x="76" y="82" font-family="IBM Plex Mono, monospace" font-size="7.5" letter-spacing=".1em" fill="var(--oxide)">SOURCE / 01</text>
        <g stroke="var(--rule-strong)" stroke-width="1" opacity=".55">
          <line x1="76" y1="96" x2="184" y2="96" />
          <line x1="76" y1="108" x2="184" y2="108" />
          <line x1="76" y1="132" x2="172" y2="132" />
          <line x1="76" y1="144" x2="184" y2="144" />
        </g>
        <line x1="76" y1="120" x2="150" y2="120" stroke="var(--oxide)" stroke-width="1.2" />
        <circle cx="155" cy="120" r="1.8" fill="var(--brass)" />
      </g>
    </g>

    <g class="fig-rise" style="--fig-delay:.22s">
      <g transform="rotate(3 389 112)">
        <rect x="320" y="66" width="146" height="104" fill="var(--figure-shadow)" />
        <rect x="316" y="60" width="146" height="104" fill="var(--paper)" stroke="var(--rule-strong)" />
        <text x="328" y="78" font-family="IBM Plex Mono, monospace" font-size="7.5" letter-spacing=".1em" fill="var(--oxide)">NOTE / 02</text>
        <g fill="none" stroke="var(--brass)" stroke-width="1">
          <line x1="352" y1="112" x2="392" y2="98" />
          <line x1="392" y1="98" x2="414" y2="132" />
          <line x1="414" y1="132" x2="376" y2="142" />
          <line x1="376" y1="142" x2="352" y2="112" />
          <line x1="392" y1="98" x2="376" y2="142" stroke-dasharray="2 3" opacity=".55" />
        </g>
        <g fill="var(--brass)">
          <circle cx="352" cy="112" r="2.4" />
          <circle cx="392" cy="98" r="2" />
          <circle cx="414" cy="132" r="2.2" />
          <circle cx="376" cy="142" r="1.8" />
        </g>
        <g stroke="var(--rule-strong)" stroke-width="1" opacity=".55">
          <line x1="328" y1="148" x2="448" y2="148" />
        </g>
      </g>
    </g>

    <g class="fig-rise" style="--fig-delay:.34s">
      <g transform="rotate(-3 265 261)">
        <rect x="192" y="220" width="154" height="94" fill="var(--figure-shadow)" />
        <rect x="188" y="214" width="154" height="94" fill="var(--paper)" stroke="var(--rule-strong)" />
        <text x="200" y="230" font-family="IBM Plex Mono, monospace" font-size="7.5" letter-spacing=".1em" fill="var(--oxide)">TURN / 03</text>
        <g fill="none" stroke="var(--oxide)" stroke-width="1.2">
          <path d="M 208 282 Q 250 244 302 264" />
          <path d="M 294 258 L 304 265 L 296 273" stroke-width="1" />
          <circle cx="320" cy="240" r="7" stroke-width="1" />
        </g>
        <text x="320" y="243" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="9" fill="var(--oxide)">?</text>
        <g stroke="var(--rule-strong)" stroke-width="1" opacity=".55">
          <line x1="200" y1="288" x2="322" y2="288" />
          <line x1="200" y1="300" x2="300" y2="300" />
        </g>
      </g>
    </g>

    <g class="fig-rise" style="--fig-delay:.46s">
      <g transform="rotate(2 111 264)">
        <rect x="80" y="226" width="70" height="88" fill="var(--figure-shadow)" />
        <rect x="76" y="220" width="70" height="88" fill="var(--paper-2)" stroke="var(--rule-strong)" />
        <text
          x="111"
          y="270"
          text-anchor="middle"
          style="font-family:var(--display)"
          font-size="38"
          fill="var(--oxide)"
        >Q</text>
        <text x="111" y="292" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="7" letter-spacing=".14em" fill="var(--ink-soft)">OPEN</text>
        <line x1="86" y1="300" x2="136" y2="300" stroke="var(--rule-strong)" stroke-width="1" opacity=".55" />
      </g>
    </g>

    <g fill="var(--brass)">
      {
        pins.map((pin) => (
          <g class="fig-pop" style={`--fig-delay:${pin.delay}s`}>
            <circle cx={pin.x} cy={pin.y} r="2.8" />
            <circle cx={pin.x} cy={pin.y} r=".9" fill="var(--on-dark)" opacity=".45" />
          </g>
        ))
      }
    </g>

    <g class="fig-fade" font-family="IBM Plex Mono, monospace" font-size="8" letter-spacing=".1em" fill="var(--ink-soft)" style="--fig-delay:1.2s">
      <text x="64" y="338">THE THREAD IS THE THOUGHT</text>
      <text x="456" y="338" text-anchor="end">NOT FILED</text>
    </g>
  </svg>
  <figcaption class="figure-caption">
    Sources are pinned where they were found; the threads are the thinking. / Not to scale.
  </figcaption>
</figure>
