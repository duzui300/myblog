---
import { sections, searchEntry, mapGroups, telescope } from '../data/sections';

interface Props {
  variant?: 'section' | 'hero';
}

const { variant = 'section' } = Astro.props;
const panelData = [...sections, searchEntry].map((item) => ({
  key: item.key,
  no: item.no,
  kicker: item.groupLabel ? `${item.groupLabel} / ${item.mode}` : item.mode,
  title: item.title,
  panelDesc: item.panelDesc,
  href: item.href,
  panelLabel: item.panelLabel,
}));
const initial = panelData[0];

const railTicks: { x1: number; y1: number; x2: number; y2: number; major: boolean }[] = [];
for (let p = 60; p <= 660; p += 20) {
  const major = (p - 60) % 80 === 0;
  railTicks.push({ x1: p, y1: 52, x2: p, y2: major ? 60 : 56, major });
  railTicks.push({ x1: p, y1: 668, x2: p, y2: major ? 660 : 664, major });
  railTicks.push({ x1: 52, y1: p, x2: major ? 60 : 56, y2: p, major });
  railTicks.push({ x1: 668, y1: p, x2: major ? 660 : 664, y2: p, major });
}
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const railLabels: { x: number; y: number; label: string }[] = [];
for (let p = 140; p < 660; p += 80) {
  railLabels.push({ x: p, y: 50, label: roman[(p - 140) / 80] ?? '' });
}
const sightDx = telescope.sight.x2 - telescope.sight.x1;
const sightDy = telescope.sight.y2 - telescope.sight.y1;
const sightLength = Math.hypot(sightDx, sightDy);
const sightStop = {
  x: telescope.sight.x2 - (sightDx / sightLength) * 16,
  y: telescope.sight.y2 - (sightDy / sightLength) * 16,
};
---
<section
  class={`astronomical-index${variant === 'hero' ? ' index-hero' : ''}`}
  aria-labelledby={variant === 'section' ? 'index-title' : 'home-title'}
>
  <div class={variant === 'section' ? 'wrap' : ''}>
    {
      variant === 'section' && (
        <div class="index-head">
          <p class="smallcaps light">Astronomical index / Five fields</p>
          <h2 id="index-title">The sky as a table of contents</h2>
          <p>
            Five constellations for five fields. Hover or focus a star to read its entry. Click to
            enter. This is an index, not a game.
          </p>
        </div>
      )
    }
    <div class="index-body">
      <div class="star-map">
        <svg viewBox="0 0 720 720" role="img" aria-labelledby="starmap-title starmap-desc">
          <title id="starmap-title">An astronomical index of five constellations and a telescope</title>
          <desc id="starmap-desc">
            A coordinate chart with five labeled constellations for Notes, Thoughts, Research,
            Projects, and About, plus a telescope linked to the archive search.
          </desc>
          <defs>
            <filter id="star-halo" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur in="SourceGraphic" stdDeviation="2" result="blur" />
              <feMerge>
                <feMergeNode in="blur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
            <g id="diffraction-cross">
              <line x1="-8" y1="0" x2="8" y2="0" stroke="var(--brass)" stroke-width=".8" opacity=".85" />
              <line x1="0" y1="-8" x2="0" y2="8" stroke="var(--brass)" stroke-width=".8" opacity=".85" />
              <circle cx="0" cy="0" r="3.2" fill="var(--brass)" stroke="none" />
              <circle cx="0" cy="0" r="1.1" fill="var(--on-dark)" stroke="none" />
            </g>
          </defs>
          <g stroke="rgba(243,239,229,.14)" stroke-width="1">
            <line x1="80" y1="60" x2="80" y2="660" /><line x1="160" y1="60" x2="160" y2="660" />
            <line x1="240" y1="60" x2="240" y2="660" /><line x1="320" y1="60" x2="320" y2="660" />
            <line x1="400" y1="60" x2="400" y2="660" /><line x1="480" y1="60" x2="480" y2="660" />
            <line x1="560" y1="60" x2="560" y2="660" /><line x1="640" y1="60" x2="640" y2="660" />
            <line x1="60" y1="80" x2="660" y2="80" /><line x1="60" y1="160" x2="660" y2="160" />
            <line x1="60" y1="240" x2="660" y2="240" /><line x1="60" y1="320" x2="660" y2="320" />
            <line x1="60" y1="400" x2="660" y2="400" /><line x1="60" y1="480" x2="660" y2="480" />
            <line x1="60" y1="560" x2="660" y2="560" /><line x1="60" y1="640" x2="660" y2="640" />
          </g>
          <g stroke="rgba(243,239,229,.32)" fill="none" stroke-width="1">
            <rect x="60" y="60" width="600" height="600" />
            <line x1="60" y1="72" x2="72" y2="72" /><line x1="60" y1="72" x2="60" y2="84" />
            <line x1="660" y1="72" x2="648" y2="72" /><line x1="660" y1="72" x2="660" y2="84" />
            <line x1="60" y1="648" x2="72" y2="648" /><line x1="60" y1="648" x2="60" y2="636" />
            <line x1="660" y1="648" x2="648" y2="648" /><line x1="660" y1="648" x2="660" y2="636" />
          </g>
          <rect x="52" y="52" width="616" height="616" fill="none" stroke="rgba(243,239,229,.2)" />
          <g>
            {
              railTicks.map((tick) => (
                <line
                  x1={tick.x1}
                  y1={tick.y1}
                  x2={tick.x2}
                  y2={tick.y2}
                  stroke={tick.major ? 'rgba(243,239,229,.4)' : 'rgba(243,239,229,.2)'}
                  stroke-width={tick.major ? '1' : '.7'}
                />
              ))
            }
          </g>
          <g fill="rgba(243,239,229,.35)">
            <circle cx="112" cy="132" r="1.2" /><circle cx="208" cy="92" r="1" /><circle cx="288" cy="146" r="1.4" />
            <circle cx="372" cy="88" r="1" /><circle cx="452" cy="126" r="1.2" /><circle cx="526" cy="96" r="1" />
            <circle cx="606" cy="176" r="1.3" /><circle cx="126" cy="254" r="1" /><circle cx="214" cy="316" r="1.2" />
            <circle cx="300" cy="268" r="1" /><circle cx="386" cy="336" r="1.3" /><circle cx="476" cy="292" r="1" />
            <circle cx="552" cy="376" r="1.2" /><circle cx="628" cy="430" r="1" /><circle cx="118" cy="438" r="1.3" />
            <circle cx="206" cy="512" r="1" /><circle cx="292" cy="448" r="1.2" /><circle cx="382" cy="526" r="1" />
            <circle cx="470" cy="602" r="1.2" /><circle cx="566" cy="552" r="1" /><circle cx="638" cy="626" r="1.3" />
          </g>
          <g class="map-group">
            {
              mapGroups.map((group) => (
                <>
                  <line
                    x1={group.line.x1}
                    y1={group.line.y1}
                    x2={group.line.x2}
                    y2={group.line.y2}
                  />
                  <text x={group.x} y={group.y}>{group.label}</text>
                </>
              ))
            }
          </g>
          {
            sections.map((section) => (
              <g class="constellation" data-constellation={section.key}>
                {section.constellation.paths.map((path) => (
                  <path class="ink-draw" d={path} />
                ))}
                {section.constellation.stars.map((star) =>
                  'major' in star && star.major ? (
                    <>
                      <circle class="major-halo" cx={star.x} cy={star.y} r="13" />
                      <use
                        class="major-cross"
                        href="#diffraction-cross"
                        x={star.x}
                        y={star.y}
                        filter="url(#star-halo)"
                      />
                    </>
                  ) : (
                    <circle class="star" cx={star.x} cy={star.y} r="1.8" />
                  ),
                )}
              </g>
            ))
          }
          <g class="telescope-sight" aria-hidden="true">
            <line
              x1={telescope.sight.x1}
              y1={telescope.sight.y1}
              x2={sightStop.x}
              y2={sightStop.y}
            />
            <circle class="reticle-ring" cx={telescope.star.x} cy={telescope.star.y} r="8" />
            <circle class="reticle-ring reticle-outer" cx={telescope.star.x} cy={telescope.star.y} r="16" />
            <g class="reticle-ticks">
              <line x1={telescope.star.x} y1={telescope.star.y - 24} x2={telescope.star.x} y2={telescope.star.y - 18} />
              <line x1={telescope.star.x} y1={telescope.star.y + 18} x2={telescope.star.x} y2={telescope.star.y + 24} />
              <line x1={telescope.star.x - 24} y1={telescope.star.y} x2={telescope.star.x - 18} y2={telescope.star.y} />
              <line x1={telescope.star.x + 18} y1={telescope.star.y} x2={telescope.star.x + 24} y2={telescope.star.y} />
            </g>
            <circle class="search-star" cx={telescope.star.x} cy={telescope.star.y} r="2.4" />
          </g>
          <g class="map-label">
            <text x="72" y="40">ASTRONOMICAL INDEX / VOL. I</text>
            <text x="648" y="40" text-anchor="end">RA 12h — 24h / DEC +60° — -20°</text>
            <g font-size="6" text-anchor="middle" opacity=".8">
              {railLabels.map((item) => <text x={item.x} y={item.y}>{item.label}</text>)}
            </g>
            <text x="72" y="696">HOVER OR FOCUS A CONSTELLATION</text>
            <text x="648" y="696" text-anchor="end">FIVE CONSTELLATIONS / ONE ARCHIVE</text>
          </g>
        </svg>
        {
          sections.map((section) => (
            <a
              class={`star-button${section.constellation.labelSide === 'left' ? ' label-left' : ''}`}
              href={section.href}
              data-target={section.key}
              style={`left:${section.constellation.button.left};top:${section.constellation.button.top}`}
              aria-label={`Enter ${section.title}`}
            >
              <span class="star-dot" />
              <span class="star-label">{section.title}</span>
            </a>
          ))
        }
        <a
          class="star-button telescope-button label-left"
          href={searchEntry.href}
          data-target={searchEntry.key}
          style={`left:${telescope.button.left};top:${telescope.button.top}`}
          aria-label="Search the archive"
        >
          <svg class="telescope-icon" viewBox="0 0 64 64" aria-hidden="true">
            <path d="M17 45 L46 12 L52 17 L23 50 Z" />
            <path d="M43 7 L57 16 L53 23 L39 14 Z" />
            <path d="M43 7 L39 14" />
            <path d="M15 47 L20 52 L17 57 L12 52 Z" />
            <path d="M12 52 L9 56" />
            <path d="M29 23 L39 12 L42 15 L32 26 Z" />
            <path d="M31 45 L31 52" />
            <path d="M34 41 L34 52" />
            <circle cx="32.5" cy="47" r="2.2" />
            <path d="M29 48 L23 52" />
            <circle cx="22" cy="53" r="1.8" fill="currentColor" stroke="none" />
            <path d="M31 52 L16 63 M34 52 L48 63 M32 52 L33 63" />
            <path d="M13 63 L19 63 M46 63 L52 63" />
            <circle cx="21" cy="49" r="1" fill="currentColor" stroke="none" />
            <circle cx="24" cy="52" r="1" fill="currentColor" stroke="none" />
          </svg>
          <span class="star-label">Search</span>
        </a>
      </div>
      <aside class="index-panel" aria-live="polite">
        <p class="panel-no" data-panel-no>{initial.no}</p>
        <p class="panel-mode" data-panel-mode>{initial.kicker}</p>
        <h3 class="panel-title" data-panel-title>{initial.title}</h3>
        <p class="panel-desc" data-panel-desc>{initial.panelDesc}</p>
        <a class="panel-link" data-panel-link href={initial.href}>{initial.panelLabel}</a>
      </aside>
    </div>
    <div class="index-foot">
      <span>Hover or focus to read</span>
      <span>Click to enter</span>
    </div>
  </div>
</section>

<script define:vars={{ panelData }}>
  const data = Object.fromEntries(panelData.map((item) => [item.key, item]));
  const buttons = Array.from(document.querySelectorAll('.star-button'));
  const groups = Array.from(document.querySelectorAll('.constellation'));
  const sight = document.querySelector('.telescope-sight');
  const map = document.querySelector('.star-map');
  const panel = document.querySelector('.index-panel');
  const panelNo = document.querySelector('[data-panel-no]');
  const panelMode = document.querySelector('[data-panel-mode]');
  const panelTitle = document.querySelector('[data-panel-title]');
  const panelDesc = document.querySelector('[data-panel-desc]');
  const panelLink = document.querySelector('[data-panel-link]');

  if (panelNo && panelMode && panelTitle && panelDesc && panelLink) {
    function setActive(key) {
      const item = data[key];
      if (!item) return;
      const activeGroup = groups.find(
        (group) => group.getAttribute('data-constellation') === key,
      );
      const activeButton = buttons.find(
        (button) => button.getAttribute('data-target') === key,
      );
      buttons.forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-target') === key);
      });

      const dot = activeButton?.querySelector('.star-dot');
      let destination = null;
      if (dot && map) {
        const mapRect = map.getBoundingClientRect();
        const dotRect = dot.getBoundingClientRect();
        const scale = map.clientWidth ? 720 / map.clientWidth : 1;
        destination = {
          x: (dotRect.left + dotRect.width / 2 - (mapRect.left + map.clientLeft)) * scale,
          y: (dotRect.top + dotRect.height / 2 - (mapRect.top + map.clientTop)) * scale,
        };
      }

      groups.forEach((group) => {
        const active = group.getAttribute('data-constellation') === key;
        group.classList.toggle('active', active);
        const cross = group.querySelector('.major-cross');
        if (!cross) return;
        if (!active || !destination) {
          cross.style.transform = 'translate(0px, 0px)';
          return;
        }
        const starX = Number(cross.getAttribute('x'));
        const starY = Number(cross.getAttribute('y'));
        cross.style.transform = `translate(${destination.x - starX}px, ${
          destination.y - starY
        }px)`;
      });
      sight?.classList.toggle('lit', Boolean(activeGroup));

      panelNo.textContent = item.no;
      panelMode.textContent = item.kicker;
      panelTitle.textContent = item.title;
      panelDesc.textContent = item.panelDesc;
      panelLink.textContent = item.panelLabel;
      panelLink.setAttribute('href', item.href);
      if (panel) {
        panel.classList.remove('swap');
        void panel.offsetWidth;
        panel.classList.add('swap');
      }
    }

    buttons.forEach((button) => {
      const key = button.getAttribute('data-target');
      if (!key) return;
      button.addEventListener('mouseenter', () => setActive(key));
      button.addEventListener('focus', () => setActive(key));
    });

    setActive(panelData[0].key);
  }
</script>
