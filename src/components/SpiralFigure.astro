      <path
        class="fig-fade"
        d="M 260 180 C 274 180 282 191 274 202 C 262 216 240 212 234 196 C 226 176 246 156 270 156 C 300 156 318 180 312 206 C 304 238 270 254 242 242 C 208 226 202 184 224 158 C 250 126 300 124 332 154"
        stroke="var(--brass)"
        fill="none"
        stroke-width="1"
        stroke-dasharray="2 5"
        style="--fig-delay:.48s"
      />
