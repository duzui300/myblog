        <rect x="100" y="60" width="320" height="198" />
        <line x1="298" y1="60" x2="298" y2="258" />
        <line x1="298" y1="182" x2="420" y2="182" />
        <line x1="360" y1="182" x2="360" y2="258" />
        <line x1="360" y1="216" x2="420" y2="216" />
        <line x1="100" y1="60" x2="420" y2="258" stroke-dasharray="3 5" opacity=".55" />
        <line x1="100" y1="258" x2="420" y2="60" stroke-dasharray="3 5" opacity=".55" />
      </g>
    </g>

    <g class="fig-fade" style="--fig-delay:.7s">
      <circle cx="260" cy="180" r="128" stroke="var(--rule-strong)" fill="none" stroke-dasharray="2 8" />
      <circle cx="260" cy="180" r="92" stroke="var(--rule)" fill="none" />
      <circle cx="260" cy="180" r="56" stroke="var(--rule)" fill="none" />
      <ellipse cx="260" cy="180" rx="150" ry="92" stroke="var(--rule)" fill="none" stroke-dasharray="1 6" opacity=".6" />
    </g>

    <path
      class="ink-draw"
      d="M 260 180 C 282 180 292 196 280 210 C 264 230 234 226 224 202 C 212 174 238 146 270 146 C 310 146 334 178 326 214 C 316 258 268 280 228 262 C 180 240 172 182 202 146 C 238 102 306 100 350 142 C 394 184 388 254 338 288"
      stroke="var(--oxide)"
      fill="none"
      stroke-width="1.4"
    />
