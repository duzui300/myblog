        <line x1="260" y1="180" x2="202" y2="146" />
        <line x1="260" y1="180" x2="350" y2="142" />
      </g>
    </g>

    <g class="fig-fade" fill="var(--brass)" style="--fig-delay:1s">
      <circle cx="224" cy="202" r="1.8" />
      <circle cx="270" cy="146" r="2.1" />
      <circle cx="326" cy="214" r="1.8" />
      <circle cx="228" cy="262" r="1.7" />
      <circle cx="202" cy="146" r="1.7" />
      <circle cx="350" cy="142" r="2" />
      <circle cx="338" cy="288" r="1.7" />
      <circle cx="242" cy="242" r="1.2" opacity=".7" />
    </g>
    <path class="fig-pop" d="M 260 170 L 263 177 L 270 180 L 263 183 L 260 190 L 257 183 L 250 180 L 257 177 Z" fill="var(--brass)" style="--fig-delay:.12s" />
    <path class="fig-pop" d="M 350 136 L 352 140 L 356 142 L 352 144 L 350 148 L 348 144 L 344 142 L 348 140 Z" fill="var(--oxide)" style="--fig-delay:1.08s" />
    <path class="fig-fade" d="M 338 282 L 342 288 L 334 289" stroke="var(--oxide)" fill="none" stroke-width="1" style="--fig-delay:1.14s" />

    <g style="--fig-delay:.24s" class="fig-fade">
      <g font-family="IBM Plex Mono, monospace" font-size="9" fill="var(--ink-soft)" letter-spacing=".1em" stroke="var(--paper-3)" stroke-width="2" paint-order="stroke">
        <text x="260" y="210" text-anchor="middle">THE QUESTION</text>
      </g>
    </g>
    <g class="fig-fade" font-family="IBM Plex Mono, monospace" font-size="9" fill="var(--ink-soft)" letter-spacing=".1em" stroke="var(--paper-3)" stroke-width="2" paint-order="stroke" style="--fig-delay:1.16s">
      <text x="350" y="130" text-anchor="middle">01</text>
      <text x="338" y="306" text-anchor="middle">02</text>
      <text x="180" y="128" text-anchor="middle">03</text>
      <text x="394" y="240">THE TURN</text>
    </g>
    <g opacity=".7">
      <g class="fig-fade" stroke="var(--oxide)" fill="none" stroke-width="1" style="--fig-delay:1.2s">
        <line x1="390" y1="250" x2="430" y2="250" />
        <circle cx="430" cy="250" r="2" fill="var(--oxide)" stroke="none" />
      </g>
    </g>

    <g class="fig-fade" font-family="IBM Plex Mono, monospace" font-size="9" fill="var(--ink-soft)" letter-spacing=".1em" stroke="var(--paper-3)" stroke-width="2" paint-order="stroke" style="--fig-delay:1.22s">
      <text x="100" y="282" text-anchor="middle">φ = 1.618</text>
      <text x="420" y="282" text-anchor="end">FIG. 02</text>
    </g>
  </svg>
  <figcaption class="figure-caption">
    A thought turns around a question until the question changes. / Not to scale.
  </figcaption>
</figure>
