<figure class="library-figure">
  <div class="figure-band">
    <span><b>FIG. 02</b> / The spiral</span><span>Thoughts / 01.2</span>
  </div>
  <svg viewBox="0 0 520 380" role="img" aria-labelledby="spiral-title spiral-desc">
    <title id="spiral-title">A golden-ratio spiral of thought with stars</title>
    <desc id="spiral-desc">
      A line drawing of a spiral built inside a golden rectangle, with stars along its turns, a central
      question, and a marked turn.
    </desc>

    <g class="fig-fade" stroke="var(--rule-strong)" fill="none" stroke-width="1" style="--fig-delay:.98s">
      <rect x="18" y="18" width="484" height="344" />
      <line x1="18" y1="32" x2="32" y2="32" /><line x1="18" y1="32" x2="18" y2="46" />
      <line x1="502" y1="32" x2="488" y2="32" /><line x1="502" y1="32" x2="502" y2="46" />
      <line x1="18" y1="348" x2="32" y2="348" /><line x1="18" y1="348" x2="18" y2="334" />
      <line x1="502" y1="348" x2="488" y2="348" /><line x1="502" y1="348" x2="502" y2="334" />
    </g>

    <g class="fig-fade" stroke="var(--grid-ink)" stroke-width=".6" style="--fig-delay:.92s">
      <line x1="60" y1="40" x2="60" y2="344" /><line x1="100" y1="40" x2="100" y2="344" />
      <line x1="140" y1="40" x2="140" y2="344" /><line x1="180" y1="40" x2="180" y2="344" />
      <line x1="220" y1="40" x2="220" y2="344" /><line x1="260" y1="40" x2="260" y2="344" />
      <line x1="300" y1="40" x2="300" y2="344" /><line x1="340" y1="40" x2="340" y2="344" />
      <line x1="380" y1="40" x2="380" y2="344" /><line x1="420" y1="40" x2="420" y2="344" />
      <line x1="460" y1="40" x2="460" y2="344" />
      <line x1="40" y1="60" x2="480" y2="60" /><line x1="40" y1="100" x2="480" y2="100" />
      <line x1="40" y1="140" x2="480" y2="140" /><line x1="40" y1="180" x2="480" y2="180" />
      <line x1="40" y1="220" x2="480" y2="220" /><line x1="40" y1="260" x2="480" y2="260" />
      <line x1="40" y1="300" x2="480" y2="300" /><line x1="40" y1="340" x2="480" y2="340" />
    </g>

    <g opacity=".85">
