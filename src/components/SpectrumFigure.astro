---
const source = { x: 56, y: 180 };
const entry = { x: 205.3, y: 180 };
const exit = { x: 236, y: 170 };
const fan = [122, 142, 162, 182, 202].map((y, index) => ({
  x1: exit.x,
  y1: exit.y,
  x2: 352,
  y2: y,
  oxide: index === 4,
  delay: 0.98 + index * 0.06,
}));
const spectralLines = [
  { y: 126, length: 12, label: 'Hγ' },
  { y: 138, length: 26, label: '' },
  { y: 150, length: 18, label: 'Hβ' },
  { y: 166, length: 10, label: '' },
  { y: 178, length: 30, label: '' },
  { y: 190, length: 16, label: 'Hα' },
  { y: 202, length: 22, label: '' },
].map((line, index) => ({ ...line, delay: 1.4 + index * 0.035 }));
const railTicks = [];
for (let y = 100; y <= 252; y += 8) {
  const major = (y - 100) % 40 === 0;
  railTicks.push({ y, major });
}
---
<figure class="mode-figure">
  <svg viewBox="0 0 440 360" role="img" aria-labelledby="spectrum-title spectrum-desc">
    <title id="spectrum-title">An atom sending a beam through a prism, resolving into spectral lines</title>
    <desc id="spectrum-desc">
      An atom at the left emits a beam through a hatched prism. The beam leaves as a fan of rays that
      scatters across a graduated detector rail, where several spectral lines are marked.
    </desc>
    <defs>
      <clipPath id="spectrum-prism-clip">
        <path d="M 184 140 L 252 140 L 218 204 Z" />
      </clipPath>
      <pattern id="spectrum-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="var(--brass)" stroke-width=".6" opacity=".5" />
      </pattern>
    </defs>

    <g class="fig-fade" stroke="rgba(243,239,229,.28)" fill="none" stroke-width="1" style="--fig-delay:0s">
      <rect x="18" y="18" width="404" height="324" />
      <line x1="18" y1="32" x2="32" y2="32" /><line x1="18" y1="32" x2="18" y2="46" />
      <line x1="422" y1="32" x2="408" y2="32" /><line x1="422" y1="32" x2="422" y2="46" />
      <line x1="18" y1="328" x2="32" y2="328" /><line x1="18" y1="328" x2="18" y2="314" />
      <line x1="422" y1="328" x2="408" y2="328" /><line x1="422" y1="328" x2="422" y2="314" />
    </g>

    <g class="fig-fade" stroke="rgba(243,239,229,.10)" fill="none" stroke-width=".8" style="--fig-delay:.18s">
      <line x1="44" y1="180" x2="396" y2="180" />
      <circle cx="236" cy="170" r="116" stroke-dasharray="2 8" />
      <circle cx="236" cy="170" r="78" stroke-dasharray="1 9" />
    </g>

    <g fill="none" stroke="rgba(243,239,229,.42)" stroke-width="1">
      <ellipse class="fig-draw" pathLength="1" cx={source.x} cy={source.y} rx="16" ry="5.5" transform="rotate(28 56 180)" style="--fig-delay:.04s" />
      <ellipse class="fig-draw" pathLength="1" cx={source.x} cy={source.y} rx="16" ry="5.5" transform="rotate(-28 56 180)" style="--fig-delay:.12s" />
      <circle class="fig-draw" pathLength="1" cx={source.x} cy={source.y} r="7" style="--fig-delay:.2s" />
      <circle class="fig-fade" cx={source.x} cy={source.y} r="12" stroke-dasharray="1 5" style="--fig-delay:.3s" />
    </g>
    <circle class="fig-pulse" cx={source.x} cy={source.y} r="12" fill="none" stroke="var(--brass)" stroke-width="1" style="--fig-delay:.34s" />
    <circle class="fig-pop" cx={source.x} cy={source.y} r="2.4" fill="var(--brass)" style="--fig-delay:.28s" />

    <line class="fig-draw" pathLength="1" x1="74" y1="180" x2={entry.x - 2} y2="180" stroke="rgba(243,239,229,.4)" stroke-width=".9" style="--fig-delay:.52s" />
    <path class="fig-fade" d="M 130 176 L 138 180 L 130 184" fill="none" stroke="var(--brass)" stroke-width=".8" opacity=".8" style="--fig-delay:.82s" />

    <path class="fig-draw" pathLength="1" d="M 184 140 L 252 140 L 218 204 Z" fill="rgba(165,141,97,.05)" stroke="var(--brass)" stroke-width="1.2" style="--fig-delay:.72s" />
    <g clip-path="url(#spectrum-prism-clip)">
      <g opacity=".5">
        <rect class="fig-fade" x="180" y="136" width="76" height="72" fill="url(#spectrum-hatch)" style="--fig-delay:.94s" />
      </g>
    </g>
    <line class="fig-fade" x1={entry.x} y1={entry.y} x2={exit.x} y2={exit.y} stroke="var(--brass)" stroke-width=".8" stroke-dasharray="2 3" style="--fig-delay:.96s" />
    <circle class="fig-pop" cx={entry.x} cy={entry.y} r="1.6" fill="var(--brass)" style="--fig-delay:.98s" />
    <circle class="fig-pop" cx={exit.x} cy={exit.y} r="1.6" fill="var(--brass)" style="--fig-delay:1.02s" />

    <g stroke-width=".8" fill="none">
      {
        fan.map((ray) => (
          <line
            class="fig-draw"
            pathLength="1"
            x1={ray.x1}
            y1={ray.y1}
            x2={ray.x2}
            y2={ray.y2}
            stroke={ray.oxide ? 'var(--oxide)' : 'rgba(243,239,229,.36)'}
            opacity={ray.oxide ? '.85' : '1'}
            style={`--fig-delay:${ray.delay}s`}
          />
        ))
      }
    </g>

    <line class="fig-draw" pathLength="1" x1="352" y1="96" x2="352" y2="256" stroke="rgba(243,239,229,.35)" stroke-width="1" style="--fig-delay:1.24s" />
    <g class="fig-fade" stroke="rgba(243,239,229,.3)" stroke-width=".7" style="--fig-delay:1.3s">
      {
        railTicks.map((tick) => (
          <line x1="352" y1={tick.y} x2={tick.major ? 362 : 357} y2={tick.y} />
        ))
      }
    </g>
    <g stroke="var(--brass)" stroke-width="1.1" opacity=".9">
      {
        spectralLines.map((line) => (
          <line
            class="fig-draw"
            pathLength="1"
            x1={352 - line.length}
            y1={line.y}
            x2="352"
            y2={line.y}
            style={`--fig-delay:${line.delay}s`}
          />
        ))
      }
    </g>
    <g class="fig-fade" font-family="'IBM Plex Mono', monospace" font-size="7.5" fill="var(--oxide)" letter-spacing=".06em" style="--fig-delay:1.5s">
      {spectralLines.filter((line) => line.label).map((line) => <text x="314" y={line.y - 4} text-anchor="end">{line.label}</text>)}
    </g>

    <g class="fig-fade" font-family="'IBM Plex Mono', monospace" font-size="9" letter-spacing=".08em" style="--fig-delay:1.55s">
      <text x="44" y="46" fill="rgba(243,239,229,.6)">FIG. 02 / A SPECTRUM</text>
      <text x="396" y="46" text-anchor="end" fill="rgba(243,239,229,.5)">λ</text>
      <text x="44" y="318" fill="rgba(243,239,229,.5)">A BEAM, RESOLVED</text>
      <text x="396" y="318" text-anchor="end" fill="rgba(243,239,229,.5)">NOT TO SCALE</text>
    </g>
  </svg>
  <figcaption class="mode-caption">
    An atom emits; the prism resolves. An inquiry does the same to a question.
  </figcaption>
</figure>
