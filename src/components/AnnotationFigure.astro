---
const words = [
  { text: 'Puella', x: 76, case: 'NOM', center: 96 },
  { text: 'videt', x: 164, case: 'VERB', center: 180 },
  { text: 'Marcum', x: 248, case: 'ACC', center: 274 },
  { text: 'in', x: 352, case: 'PREP', center: 358 },
  { text: 'horto', x: 380, case: 'ABL', center: 398 },
];
---
<figure class="mode-figure">
  <svg viewBox="0 0 520 380" role="img" aria-labelledby="annotation-title annotation-desc">
    <title id="annotation-title">A Latin sentence with dependency annotations and an alternative reading</title>
    <desc id="annotation-desc">
      The sentence Puella videt Marcum in horto, with case labels above the words. Solid brass arcs
      mark the working dependencies; a dashed arc marks an alternative attachment. One word is
      selected and connected to an inspector panel.
    </desc>
    <defs>
      <marker id="dep-arrow" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
        <path d="M0,0 L5,2.5 L0,5 Z" fill="var(--brass)" />
      </marker>
      <marker id="dep-arrow-alt" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
        <path d="M0,0 L5,2.5 L0,5 Z" fill="var(--oxide)" />
      </marker>
    </defs>

    <g stroke="rgba(243,239,229,.28)" fill="none" stroke-width="1">
      <rect x="18" y="18" width="484" height="344" />
      <line x1="18" y1="32" x2="32" y2="32" /><line x1="18" y1="32" x2="18" y2="46" />
      <line x1="502" y1="32" x2="488" y2="32" /><line x1="502" y1="32" x2="502" y2="46" />
      <line x1="18" y1="348" x2="32" y2="348" /><line x1="18" y1="348" x2="18" y2="334" />
      <line x1="502" y1="348" x2="488" y2="348" /><line x1="502" y1="348" x2="502" y2="334" />
    </g>

    <g stroke="rgba(243,239,229,.16)" fill="none" stroke-width=".8">
      <line x1="44" y1="78" x2="476" y2="78" />
      <line x1="44" y1="300" x2="476" y2="300" />
      <line x1="44" y1="74" x2="44" y2="82" />
      <line x1="476" y1="74" x2="476" y2="82" />
      <line x1="44" y1="296" x2="44" y2="304" />
      <line x1="476" y1="296" x2="476" y2="304" />
      <circle cx="31" cy="140" r="2.6" />
      <circle cx="31" cy="240" r="2.6" />
    </g>

    <g font-family="'EB Garamond', serif" font-size="15" fill="rgba(243,239,229,.85)">
      {words.map((word) => <text x={word.x} y="214">{word.text}</text>)}
    </g>
    <line x1="64" y1="220" x2="456" y2="220" stroke="rgba(243,239,229,.24)" stroke-width=".8" />

    <g font-family="'IBM Plex Mono', monospace" font-size="7.5" fill="var(--brass)" letter-spacing=".08em" text-anchor="middle">
      {
        words.map((word) => (
          <>
            <text x={word.center} y="190">{word.case}</text>
            <line x1={word.center} y1="194" x2={word.center} y2="200" stroke="var(--brass)" stroke-width=".7" opacity=".7" />
          </>
        ))
      }
    </g>

    <g fill="none" stroke="var(--brass)" stroke-width="1" opacity=".85">
      <path d="M 96 222 Q 138 252 176 224" marker-end="url(#dep-arrow)" />
      <path d="M 184 222 Q 230 254 270 224" marker-end="url(#dep-arrow)" />
      <path d="M 398 222 Q 292 296 184 226" marker-end="url(#dep-arrow)" />
    </g>
    <path
      d="M 398 222 Q 340 266 278 226"
      fill="none"
      stroke="var(--oxide)"
      stroke-width=".9"
      stroke-dasharray="3 4"
      marker-end="url(#dep-arrow-alt)"
    />

    <rect x="374" y="197" width="48" height="27" fill="rgba(165,141,97,.08)" stroke="var(--brass)" stroke-width=".8" />
    <line x1="420" y1="197" x2="420" y2="174" stroke="var(--brass)" stroke-width=".7" stroke-dasharray="2 3" opacity=".8" />

    <g fill="#1C1F26">
      <rect x="348" y="88" width="120" height="86" stroke="rgba(243,239,229,.24)" stroke-width=".8" />
    </g>
    <line x1="360" y1="112" x2="456" y2="112" stroke="rgba(243,239,229,.16)" stroke-width=".7" />
    <g font-family="'IBM Plex Mono', monospace" font-size="7.5" letter-spacing=".07em">
      <text x="360" y="104" fill="rgba(243,239,229,.5)">INSPECTOR</text>
      <text x="360" y="131" font-family="'EB Garamond', serif" font-size="14" font-style="italic" letter-spacing="0" fill="var(--on-dark)">horto</text>
      <text x="360" y="147" fill="var(--brass)">ABL · PLACE</text>
      <text x="360" y="162" fill="rgba(243,239,229,.5)">1 WORKING / 1 ALT</text>
    </g>

    <g font-family="'IBM Plex Mono', monospace" font-size="8.5" letter-spacing=".08em">
      <text x="56" y="62" fill="rgba(243,239,229,.6)">FIG. 02 / DEPENDENCY</text>
      <text x="466" y="62" text-anchor="end" fill="rgba(243,239,229,.6)">TABLINVM</text>
      <line x1="56" y1="320" x2="78" y2="320" stroke="var(--brass)" stroke-width="1" />
      <text x="86" y="323" fill="rgba(243,239,229,.55)">working reading</text>
      <line x1="214" y1="320" x2="236" y2="320" stroke="var(--oxide)" stroke-width="1" stroke-dasharray="3 4" />
      <text x="244" y="323" fill="rgba(243,239,229,.55)">alternative</text>
      <text x="466" y="323" text-anchor="end" fill="rgba(243,239,229,.5)">NOT A SCORE</text>
    </g>
  </svg>
  <figcaption class="mode-caption">
    A working reading is drawn in solid lines. Competing analyses stay on the page as alternatives,
    with their evidence, and never overwrite the reader's own annotation.
  </figcaption>
</figure>
